# Credenciais do projeto Supabase consumidas pela SPA (Vite expoe apenas VITE_*).
# Copie para `.env` e preencha: `cp .env.example .env`
#
# `src/integrations/supabase/client.ts` le estas variaveis sem valor padrao —
# rodar `npm run dev` sem elas quebra a criacao do client.
#
# A chave publishable e publica por natureza (vai para o bundle do navegador);
# o que protege os dados e o RLS no banco, nao o sigilo desta chave. Nunca
# coloque aqui a service_role.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
VITE_SUPABASE_PROJECT_ID=SEU-PROJETO

# --------------------------------------------------------------------------
# Testes de integracao e de carga NAO usam este arquivo.
#
# Eles apontam para o stack local da CLI do Supabase e resolvem as chaves em
# `tests/integration/helpers/env.ts`, cujos padroes sao as chaves demo fixas da
# CLI — identicas em qualquer maquina, sem segredo envolvido.
#
# Defina as variaveis abaixo apenas para apontar as suites a outra instancia:
#   SUPABASE_URL=http://127.0.0.1:54321
#   SUPABASE_ANON_KEY=...
#   SUPABASE_SERVICE_ROLE_KEY=...
#   SEED_N=50            # numero de servicos semeados no teste de carga
#   EVID_DIR=...         # diretorio de saida das evidencias (padrao: data de hoje)
